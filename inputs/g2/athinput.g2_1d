<comment>
  Athena++ 1D stability test – Burkert+12 ambient medium
  Units: CGS | Coord: spherical_polar | EOS: adiabatic
</comment>

<job>
problem_id   = g2_1d
</job>

<output1>
file_type    = tab
variable     = prim
dt           = 3.156e8
</output1>

<output2>
file_type    = hst
dt           = 3.156e7
</output2>

<time>
cfl_number   = 0.3
tlim         = 3.156e9
integrator   = vl2
</time>

<mesh>
nx1          = 256
x1min        = 3.0e15
x1max        = 3.0e17
ix1_bc       = outflow
ox1_bc       = outflow
nx2          = 1
x2min        = 1.5207963267948966
x2max        = 1.6207963267948966
ix2_bc       = periodic
ox2_bc       = periodic
nx3          = 1
x3min        = 0.0
x3max        = 0.6283185
ix3_bc       = periodic
ox3_bc       = periodic
refinement   = none
</mesh>

<meshblock>
nx1          = 256
nx2          = 1
nx3          = 1
</meshblock>

<hydro>
gamma        = 1.6666666667
dfloor       = 1.0e-30
</hydro>

<problem>
rho0         = 9.5e-22
T0           = 2.0e8
r0           = 1.0e16
mu           = 0.5
M_BH         = 4.31e6
use_nsc      = 1
M_NSC        = 0.66e6
</problem>
