<comment>
problem   = G2 ambient medium + G2 cloud tracer (M3)
config    = --prob=g2_ambient --coord=spherical_polar --nscalars=1
method    = Burkert+12 relaxation (use_nsc=0, tau_relax=1yr) + passive tracer

<job>
problem_id = g2_2d_tracer

<output1>
file_type  = tab
