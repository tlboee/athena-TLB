x2max      = 2.0943951023931953
ix2_bc     = outflow
ox2_bc     = outflow
nx3        = 1
x3min      = 0.0
x3max      = 6.2831853071795862
ix3_bc     = periodic
ox3_bc     = periodic

<meshblock>
nx1        = 256
nx2        = 128
nx3        = 1

<hydro>
gamma      = 1.6666666667
