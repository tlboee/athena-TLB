<comment>
problem   = G2 Wolke in Burkert+12 Umgebungsmedium — M3 erster Cloud-Test
config    = --prob=g2_ambient --coord=spherical_polar --nscalars=1
physics   = do_instant (tau_relax=0): Hintergrund wird hart relaxiert,
            Wolke (tr>=1e-4) entwickelt sich frei; Kepler-Kreisgeschwindigkeit.
note      = Burkert+12 Tracer-Konvention: tr=0 Hintergrund, tr=1 Wolke

<job>
problem_id = g2_cloud

<output1>
file_type  = tab
variable   = prim
dt         = 1.0e7       # alle ~0.32 yr

<output2>
file_type  = tab
variable   = scalar
dt         = 1.0e7

<mesh>
nx1        = 256
x1min      = 3.0e15
x1max      = 3.0e17
ix1_bc     = user
ox1_bc     = outflow
nx2        = 128
x2min      = 1.0471975511965976    # pi/3  = 60 deg
x2max      = 2.0943951023931953    # 2pi/3 = 120 deg
ix2_bc     = outflow
ox2_bc     = outflow
nx3        = 1
x3min      = 0.0
x3max      = 6.2831853071795862
ix3_bc     = periodic
ox3_bc     = periodic

<meshblock>
nx1        = 256
nx2        = 128
nx3        = 1

<hydro>
gamma      = 1.6666666667
dfloor     = 1.0e-30

<time>
cfl_number = 0.3
tlim       = 6.312e7     # 2 Jahre

<problem>
# Burkert+12 Umgebungsmedium
rho0       = 9.5e-22
T0         = 2.0e8
r0         = 1.0e16
mu         = 0.5
M_BH       = 4.31e6      # [M_sun]
use_nsc    = 0

# Relaxation (do_instant: tau_relax=0 → harter Dirichlet-Reset jeden Zeitschritt)
tau_relax  = 0.0
tr_thresh  = 1.0e-4      # Burkert+12: nur tr < 1e-4 wird relaxiert

# G2-Wolke (Burkert+12, CC01 Initialposition)
x_G2       = -7.22e16   # [cm], Kartesisch im Orbitalplane
z_G2       =  2.21e16   # [cm]
R_cloud    =  1.87e15   # Wolkenradius [cm]
T_G2       =  1.0e4     # Wolkentemperatur [K]
# Dichte automatisch aus Druckgleichgewicht: rho_G2 = rho_hot(r_G2) * T_hot(r_G2) / T_G2
# Kepler-Kreisgeschwindigkeit aus M_BH (prograde: v_th < 0, abnehmender theta)
